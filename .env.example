# ============================================================
#  Commerce Platform .env  (copy to .env and fill in real values)
# ============================================================
# IMPORTANT: never commit your real .env. .env is gitignored.
#
# Config file: config.yaml (see config.yaml.example)
# Channel chat IDs are referenced as env:VAR_NAME in config.yaml.

# ---------- Telegram ----------
TELEGRAM_TOKEN=
TELEGRAM_ADMIN_CHAT=

# Channel targets (referenced as env:VAR_NAME in platform.yaml channels section)
TELEGRAM_GAMING_CHAT_ID=
TELEGRAM_DEALS_GAMING_CHAT_ID=
TELEGRAM_DEALS_TECH_CHAT_ID=

# ---------- Discord (optional) ----------
DISCORD_GAMING_WEBHOOK=
DISCORD_TECH_WEBHOOK=

# ---------- Affiliate ----------
AMAZON_AFFILIATE_TAG=

# ---------- LLM (optional — only if deals.curation.use_llm: true) ----------
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash

# ---------- Reddit aggregator (optional) ----------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=DealsPlatform/1.0

# ---------- Database (Supabase Postgres) ----------
# Postgres DSN when ``platform.store.dsn`` is unset in YAML (omit store.dsn to use this).
# Use postgresql://... — postgresql+asyncpg://... is normalized for asyncpg.
#
# Supabase “direct connection” (db.<ref>.supabase.co) can be IPv6-only. On a typical IPv4 home/office
# network, use the Session pooler string from the same page instead (“Not IPv4 compatible” → pooler).
#
# Direct (URI tab) — user postgres, host db.<project-ref>.supabase.co — ok if your network has IPv6 / add-on
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[project-ref].supabase.co:5432/postgres
#
# Session pooler (IPv4-friendly) — copy from Dashboard; user is postgres.<project-ref>, host *.pooler.supabase.com, port often 5432
DATABASE_URL=postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# Transaction pooler (port 6543) — short-lived serverless-style; use session pooler for a long-lived app unless you know you need this
# DATABASE_URL=postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# DATABASE_SSL=true   # default; TLS with certifi CA bundle
# DATABASE_SSL=false  # no TLS (e.g. Supabase “SSL enforcement” off, or local Postgres). sslmode= is stripped from the URL when false.

# ---------- HTTP API (same process as workers: python -m commerce_platform --config platform.yaml) ----------
# PLATFORM_CONFIG=platform.yaml
WEB_JWT_SECRET=
# WEB_JWT_EXPIRE_SECONDS=604800
# WEB_OPEN_REGISTRATION=true
# WEB_BOOTSTRAP_ADMIN_EMAIL=
# WEB_BOOTSTRAP_ADMIN_PASSWORD=
# WEB_REQUESTS_PER_HOUR_PER_IP=20
# WEB_CORS_ORIGINS=https://example.com
# Optional: reject requests whose Host header is not listed (comma-separated; no spaces needed)
# WEB_TRUSTED_HOSTS=yourdomain.com,www.yourdomain.com
