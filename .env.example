# ============================================================
#  DealsPlatform .env  (copy to .env and fill in real values)
# ============================================================
# IMPORTANT: never commit your real .env. .env is gitignored.

# ---------- Database (Supabase Postgres) ----------
# Use the *pooled* connection string from Supabase (port 5432, "Session" pooler).
# Asyncpg requires the postgresql+asyncpg:// scheme.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# ---------- LLM (Gemini, OpenAI-compatible API) ----------
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash

# ---------- Notifiers ----------
# Telegram
TELEGRAM_TOKEN=
# Default chat (used by legacy stock notifier flow)
TELEGRAM_CHAT_ID=
# Per-channel chat ids referenced by config/platform/channels.yaml
TELEGRAM_CHAT_TECH=
TELEGRAM_CHAT_GAMING=
TELEGRAM_CHAT_LIFESTYLE=
TELEGRAM_CHAT_HOME=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_TECH=
DISCORD_CHANNEL_GAMING=
DISCORD_CHANNEL_LIFESTYLE=
DISCORD_CHANNEL_HOME=

# Twitter / X (legacy + platform)
consumer_key=
consumer_secret=
access_token=
access_token_secret=

# WhatsApp (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TO_TECH=
WHATSAPP_TO_GAMING=
WHATSAPP_TO_LIFESTYLE=
WHATSAPP_TO_HOME=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# ---------- Aggregator sources ----------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=DealsPlatform/0.1 by your_reddit_username

# ---------- Affiliate tags ----------
AMAZON_AFFILIATE_TAG=
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# ---------- Logging ----------
LOG_JSON=0
